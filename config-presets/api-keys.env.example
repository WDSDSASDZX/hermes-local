# Copy only the lines you need into ~/.hermes/.env, then replace placeholders.
# Never commit the real ~/.hermes/.env file.

# OpenAI API
OPENAI_API_KEY=replace-me

# OpenRouter
OPENROUTER_API_KEY=replace-me

# Anthropic / Claude
ANTHROPIC_API_KEY=replace-me

# DeepSeek
DEEPSEEK_API_KEY=replace-me

# Google Gemini (either name works; prefer GEMINI_API_KEY)
GEMINI_API_KEY=replace-me
# GOOGLE_API_KEY=replace-me

# Moonshot / Kimi global and China
KIMI_API_KEY=replace-me
# KIMI_CN_API_KEY=replace-me

# MiniMax global and China
MINIMAX_API_KEY=replace-me
# MINIMAX_CN_API_KEY=replace-me

# Z.AI / GLM
ZAI_API_KEY=replace-me

# Optional remote OpenAI-compatible gateway from providers.local.yaml
# COMPANY_LLM_API_KEY=replace-me
